# Byte-compiled
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Virtual Environments
.venv/
venv/
env/

# Secrets & Env
.env
.env.*
!.env.example

# Logs
*.log
logs/

# Storage: Sessions (Browser profiles / cookies) & Exports (CSV Scraping)
storage/sessions/*_profile/
storage/sessions/**/Default/
storage/sessions/**/Profile*/
storage/exports/*.csv
storage/exports/*.json
storage/exports/*.parquet

# Keep structure files
!storage/sessions/README.md
!storage/sessions/.gitkeep
!storage/exports/README.md
!storage/exports/.gitkeep
!storage/dictionaries/README.md
!storage/dictionaries/.gitkeep

# Scratch & testing
.pytest_cache/
.coverage
scratch/
